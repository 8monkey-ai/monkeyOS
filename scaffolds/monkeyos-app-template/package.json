{
  "name": "monkeyos-app-template",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --conditions=development ./node_modules/@react-router/dev/bin.cjs dev",
    "dev:test": "bun scripts/dev-test.ts",
    "start": "bun server.ts",
    "build": "bun ./node_modules/@react-router/dev/bin.cjs build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "bun ./node_modules/@react-router/dev/bin.cjs typegen && bun ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test tests/config.test.ts tests/repository-audit.test.ts",
    "test:e2e": "bunx --bun playwright test",
    "db:start": "bunx supabase start",
    "db:reset": "bunx supabase db reset",
    "db:test": "bunx supabase start && bunx supabase db reset && bunx supabase test db",
    "db:types": "bunx supabase gen types typescript --local --schema monkeyos_app_template > src/lib/database.types.ts",
    "config:local": "bun scripts/store-local-supabase-config.ts",
    "secret:add": "bun scripts/add-secret.ts",
    "skills:sync": "bun scripts/sync-platform-skills.ts",
    "ui:add": "bunx --bun shadcn@latest add",
    "audit:repository": "bun scripts/repository-audit.ts",
    "test:container": "bun scripts/test-container.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build && bun run audit:repository --deterministic"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-babel": "^1.5.0"
  }
}
