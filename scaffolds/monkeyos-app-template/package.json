{
  "name": "monkeyos-app-template",
  "version": "2.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "BUN_OPTIONS=--conditions=development react-router dev",
    "start": "bun server.ts",
    "build": "react-router build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typegen": "react-router typegen",
    "lint": "oxlint --deny-warnings .",
    "test": "bun test",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase start && supabase db reset && supabase test db",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "config:local": "bun scripts/store-local-supabase-config.ts",
    "secret:add": "bun scripts/add-secret.ts",
    "skills:sync": "bun scripts/sync-platform-skills.ts",
    "ui:add": "shadcn add",
    "audit:repository": "bun scripts/repository-audit.ts",
    "check": "bun run format:check && bun run typegen && bun run lint && bun test && bun run build && bun run audit:repository --deterministic"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "oxc-transform-react": "^0.147.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "shadcn": "^4.19.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
